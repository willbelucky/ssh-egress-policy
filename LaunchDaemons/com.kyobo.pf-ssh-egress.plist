<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.kyobo.pf-ssh-egress</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/libexec/pf-ssh-egress-apply</string>
    </array>

    <!-- 부팅 직후 1회 적용 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 5분마다 재확인(자가치유). 정책이 조용히 사라지는 것을 방지. -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>StandardOutPath</key>
    <string>/var/log/pf-ssh-egress.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/pf-ssh-egress.log</string>
</dict>
</plist>
